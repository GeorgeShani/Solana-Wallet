# Copy to server/.env (git-ignored) and adjust. All values are optional on a normal local setup.

# The server wallet: mint authority of the devnet test tokens AND the fee relayer's fee payer.
# By default it is read from keys/admin-seed.txt (created by `bun run --cwd scripts seed-devnet`).
# ADMIN_SEED="twelve words ..."
# ADMIN_SEED_FILE=/path/to/seed.txt

# PORT=3000
# RPC_URL=https://api.devnet.solana.com

# Browser origins allowed to call the API (comma separated).
# CORS_ORIGINS=http://localhost:5173

# SQLite file for the faucet's claim history.
# DB_PATH=server/data/wallet.db
