# BACKEND (server/) settings for production.
#
# How to use: on Railway / Fly.io / Render set these names as environment variables in the dashboard (the
# recommended way, and the only safe place for ADMIN_SEED). To run it yourself with a file, copy this to
# server/.env.production and start with NODE_ENV=production (Bun then loads it automatically).
#
# NEVER commit the real file: it holds the server wallet's seed phrase. .env.production is git-ignored.

# --- Required -------------------------------------------------------------------------------------------

# The server wallet's 12-word recovery phrase. It is the mint authority of the test tokens AND the wallet that
# pays fees for relayed claims, so keep a little devnet SOL in it (about 0.003 SOL per faucet claim).
# Set it as a secret in your host. Alternative: ADMIN_SEED_FILE=/data/admin-seed.txt (a file on the volume).
ADMIN_SEED=

# The website that is allowed to call this API from a browser (comma separated, no trailing slash).
# Use your real frontend address; anything else is refused by the browser.
CORS_ORIGINS=https://wallet.example.com

# This server's own public address, as browsers and explorers see it (https://, no trailing slash).
# It is written into every NFT's on-chain metadata link, so pick the final one BEFORE minting NFTs you want to keep.
PUBLIC_URL=https://api.example.com

# --- Storage (point these at a persistent volume, or you lose data on every redeploy) --------------------

# SQLite file: faucet history and the stealth announcement index.
DB_PATH=/data/wallet.db

# Folder for uploaded NFT pictures and their metadata.
NFT_DIR=/data/nft

# --- Optional -------------------------------------------------------------------------------------------

# The port to listen on. Most hosts inject PORT themselves; leave unset unless yours does not.
# PORT=3000

# Solana devnet RPC. Use your own key here too (Helius, QuickNode ...): the server reads the whole program history
# for stealth announcements, which the public endpoint rate-limits.
RPC_URL=https://api.devnet.solana.com
